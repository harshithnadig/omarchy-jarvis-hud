#!/usr/bin/env python3
"""
JARVIS Dictation Client (Mode A — Voice Keyboard)
Offline-first voice typing directly at the cursor across Linux applications.
- Capture: AudioCapture with Silero VAD endpointing and pre-speech ring buffer
- STT: Local GPU CTranslate2 FP16 (Whisper Large-v3-Turbo)
- Polish: Context style profile + Snippets + Personal Dictionary + Backtracking + Dev Transforms
- Injection: InjectorRouter (AT-SPI -> wtype -> ydotool -> xdotool -> safe clipboard)
- Strict Boundary: Zero Assistant overhead, Zero TTS playback, Zero cloud calls.
"""
import os
import sys
import io
import wave
import json
import urllib.request

from core.audio.capture import AudioCapture
from core.context.active_window import get_active_window
from core.context.profiles import get_style_profile_for_window
from core.context.privacy import PrivacyEngine
from core.memory.dictionary import PersonalDictionary
from core.memory.snippets import SnippetManager
from core.polisher import TextPolisher
from core.inject.router import InjectorRouter

SIDECAR_URL = os.environ.get("JARVIS_SIDECAR_URL", "http://127.0.0.1:8765/transcribe")

def transcribe_audio(pcm_bytes: bytes, engine: str = None) -> str:
    """Send PCM audio to local GPU sidecar daemon or fallback to in-process router."""
    out_buf = io.BytesIO()
    with wave.open(out_buf, "wb") as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(16000)
        wf.writeframes(pcm_bytes)
    wav_data = out_buf.getvalue()

    boundary = "----WebKitFormBoundaryJarvisDictate88"
    body = (
        f"--{boundary}\r\n"
        f'Content-Disposition: form-data; name="file"; filename="audio.wav"\r\n'
        f"Content-Type: audio/wav\r\n\r\n"
    ).encode("utf-8") + wav_data + f"\r\n--{boundary}--\r\n".encode("utf-8")

    url = SIDECAR_URL
    if engine:
        url += f"?engine={engine}&raw=true"
    else:
        url += "?raw=true"

    req = urllib.request.Request(
        url,
        data=body,
        headers={"Content-Type": f"multipart/form-data; boundary={boundary}"}
    )

    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode())
            return data.get("text", "") or data.get("raw_text", "")
    except Exception as e:
        # In-process transcription fallback if sidecar daemon is temporarily down
        from core.router import EngineRouter
        router = EngineRouter()
        import tempfile
        with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
            tmp.write(wav_data)
            tmp_path = tmp.name
        try:
            res = router.transcribe(tmp_path, engine_key=engine)
            return res.text
        finally:
            if os.path.exists(tmp_path):
                os.remove(tmp_path)

def main():
    # 1. Inspect target window context & privacy boundary
    target_win = get_active_window()
    privacy = PrivacyEngine()
    is_sensitive = privacy.is_sensitive(target_win)
    allow_context = privacy.should_capture_context(target_win)

    profile = get_style_profile_for_window(target_win) if allow_context else get_style_profile_for_window(None)
    dictionary = PersonalDictionary()
    snippet_mgr = SnippetManager()

    # 2. Record audio via modular AudioCapture stack
    capture = AudioCapture(sample_rate=16000, chunk_size=512, silence_timeout_s=0.55)
    pcm_data = capture.record_utterance(max_duration_s=20.0)
    if not pcm_data:
        sys.exit(0)

    # 3. Transcribe audio on local GPU
    raw_text = transcribe_audio(pcm_data)
    if not raw_text or not raw_text.strip():
        sys.exit(0)

    # 4. Connected Polish Pipeline
    # 4a. Voice snippet expansion
    expanded = snippet_mgr.expand_snippets(raw_text)

    # 4b. Context-aware deterministic polish with backtracking & dev transforms
    polished = TextPolisher.clean_deterministic(
        expanded,
        dev_mode=(target_win.app_category == "code") if allow_context else False,
        enable_backtracking=True,
        profile=profile
    )

    # 4c. Personal technical dictionary substitution (anonymize app_class if sensitive)
    app_scope = target_win.app_class if allow_context else None
    final_text = dictionary.apply_dictionary(polished, app_class=app_scope)

    # 5. Inject text directly at active cursor
    injector = InjectorRouter()
    injector.inject_text(
        final_text,
        paste_shortcut=profile.paste_shortcut
    )

if __name__ == "__main__":
    main()
